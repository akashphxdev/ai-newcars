model SeoMeta {
  id             Int     @id @default(autoincrement())
  pageType       Int     @map("page_type")
  entityId       Int?    @map("entity_id")
  staticPageSlug String? @map("static_page_slug") @db.VarChar(100)

  metaTitle       String? @map("meta_title") @db.VarChar(255)
  metaDescription String? @map("meta_description") @db.Text
  metaKeywords    String? @map("meta_keywords") @db.Text
  canonicalUrl    String? @map("canonical_url") @db.VarChar(255)
  h1Tag           String? @map("h1_tag") @db.VarChar(255)
  ogTitle         String? @map("og_title") @db.VarChar(255)
  ogDescription   String? @map("og_description") @db.Text
  ogImage         String? @map("og_image") @db.VarChar(255)
  robotsMeta      String? @map("robots_meta") @db.VarChar(100)

  // ---- structured data / JSON-LD (car listing site ke liye important schemas) ----
  vehicleSchema    String? @map("vehicle_schema") @db.Text
  reviewSchema     String? @map("review_schema") @db.Text
  articleSchema    String? @map("article_schema") @db.Text
  authorSchema     String? @map("author_schema") @db.Text
  breadcrumbSchema String? @map("breadcrumb_schema") @db.Text

  status Boolean @default(true)

  createdBy      Int?       @map("created_by")
  createdByAdmin AdminUser? @relation("SeoMetaCreatedBy", fields: [createdBy], references: [id])
  createdAt      DateTime   @default(now()) @map("created_at")

  updatedBy      Int?       @map("updated_by")
  updatedByAdmin AdminUser? @relation("SeoMetaUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@unique([pageType, entityId])
  @@map("seo_meta")
}

model SeoRedirect {
  id             Int        @id @default(autoincrement())
  oldPath        String     @unique @map("old_path") @db.VarChar(255)
  newPath        String     @map("new_path") @db.VarChar(255)
  redirectType   Int        @default(301) @map("redirect_type")
  isActive       Boolean    @default(true) @map("is_active")
  createdBy      Int?       @map("created_by")
  createdByAdmin AdminUser? @relation("SeoRedirectCreatedBy", fields: [createdBy], references: [id])
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedBy      Int?       @map("updated_by")
  updatedByAdmin AdminUser? @relation("SeoRedirectUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt      DateTime   @updatedAt @map("updated_at")

  @@index([isActive, createdAt])
  @@map("seo_redirects")
}

