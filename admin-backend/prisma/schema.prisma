// STORIES
// ============================================================

model StoryGroup {
  id    Int    @id @default(autoincrement())
  title String @db.VarChar(100)

  coverMediaType String @map("cover_media_type") @db.VarChar(10)
  coverMediaUrl  String @map("cover_media_url") @db.VarChar(255)

  viewCount    Int     @default(0) @map("view_count")
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @map("display_order")

  createdBy      Int?       @map("created_by")
  createdByAdmin AdminUser? @relation("StoryGroupCreatedBy", fields: [createdBy], references: [id])
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedBy      Int?       @map("updated_by")
  updatedByAdmin AdminUser? @relation("StoryGroupUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt      DateTime?  @updatedAt @map("updated_at")

  items StoryItem[]

  @@unique([displayOrder])
  @@map("story_groups")
}

model StoryItem {
  id      Int        @id @default(autoincrement())
  groupId Int        @map("group_id")
  group   StoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  mediaType String @map("media_type") @db.VarChar(10)
  mediaUrl  String @map("media_url") @db.VarChar(255)

  description String? @db.VarChar(300)

  link String? @db.VarChar(255)

  viewCount    Int       @default(0) @map("view_count")
  status       String    @default("draft") @map("status") @db.VarChar(10)
  startAt      DateTime? @map("start_at")
  endAt        DateTime? @map("end_at")
  displayOrder Int       @map("display_order")

  createdBy      Int?       @map("created_by")
  createdByAdmin AdminUser? @relation("StoryItemCreatedBy", fields: [createdBy], references: [id])
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedBy      Int?       @map("updated_by")
  updatedByAdmin AdminUser? @relation("StoryItemUpdatedBy", fields: [updatedBy], references: [id])
  updatedAt      DateTime?  @updatedAt @map("updated_at")

  @@unique([groupId, displayOrder])
  @@map("story_items")
}

model Banner {
  id            Int    @id @default(autoincrement())
  name          String @db.VarChar(150)
  tagLabel      String @map("tag_label") @db.VarChar(100)
  heading       String @db.VarChar(200)
  highlightText String @map("highlight_text") @db.VarChar(150)
  description   String @db.VarChar(300)

  mediaType Int     @map("media_type") // 1=Image, 2=Video
  imageUrl  String? @map("image_url") @db.VarChar(255)
  videoUrl  String? @map("video_url") @db.VarChar(255)

  ctaText String @map("cta_text") @db.VarChar(50)
  ctaLink String @map("cta_link") @db.VarChar(255)

  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")
  clickCount   Int     @default(0) @map("click_count")

  createdBy      Int        @map("created_by")
  createdByAdmin AdminUser  @relation("BannerCreatedBy", fields: [createdBy], references: [id])
  updatedBy      Int?       @map("updated_by")
  updatedByAdmin AdminUser? @relation("BannerUpdatedBy", fields: [updatedBy], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  @@index([isActive, displayOrder])
  @@map("banners")
}

model Testimonial {
  id Int @id @default(autoincrement())

  userId Int?  @map("user_id")
  user   User? @relation(fields: [userId], references: [id])

  customerName String   @map("customer_name") @db.VarChar(100)
  customerCity String?  @map("customer_city") @db.VarChar(100)
  photoUrl     String?  @map("photo_url") @db.VarChar(255)
