  createdBy      Int       @map("created_by")
  createdByAdmin AdminUser @relation("SiteSettingCreatedBy", fields: [createdBy], references: [id])
  updatedBy      Int       @map("updated_by")
  updatedByAdmin AdminUser @relation("SiteSettingUpdatedBy", fields: [updatedBy], references: [id])

