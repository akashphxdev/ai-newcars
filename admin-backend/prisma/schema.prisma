  id          BigInt       @id @default(autoincrement())
  campaignId  Int          @map("campaign_id")
  campaign    AdCampaign   @relation(fields: [campaignId], references: [id])
  userId      Int?         @map("user_id")
  user        User?        @relation(fields: [userId], references: [id])
  pageUrl     String?      @map("page_url") @db.VarChar(255)
  deviceType  String?      @map("device_type") @db.VarChar(20)
  ipAddress   String?      @map("ip_address") @db.VarChar(45)
  viewedAt    DateTime     @default(now()) @map("viewed_at")
  sessionId   String?      @map("session_id") @db.VarChar(100)
  referrerUrl String?      @map("referrer_url") @db.VarChar(255)
  userAgent   String?      @map("user_agent") @db.VarChar(255)
  placementId Int?         @map("placement_id")
  placement   AdPlacement? @relation(fields: [placementId], references: [id])
  clicks      AdClick[]

  @@index([campaignId, viewedAt])
  @@index([sessionId])
  @@map("ad_impressions")
}

model AdClick {
  id           BigInt        @id @default(autoincrement())
  campaignId   Int           @map("campaign_id")
  campaign     AdCampaign    @relation(fields: [campaignId], references: [id])
  userId       Int?          @map("user_id")
  user         User?         @relation(fields: [userId], references: [id])
  pageUrl      String?       @map("page_url") @db.VarChar(255)
  deviceType   String?       @map("device_type") @db.VarChar(20)
  ipAddress    String?       @map("ip_address") @db.VarChar(45)
  clickedAt    DateTime      @default(now()) @map("clicked_at")
  impressionId BigInt?       @map("impression_id")
  impression   AdImpression? @relation(fields: [impressionId], references: [id])
  placementId  Int?          @map("placement_id")
  placement    AdPlacement?  @relation(fields: [placementId], references: [id])
  sessionId    String?       @map("session_id") @db.VarChar(100)
  referrerUrl  String?       @map("referrer_url") @db.VarChar(255)
  userAgent    String?       @map("user_agent") @db.VarChar(255)

  @@index([campaignId, clickedAt])
  @@index([sessionId])
  @@index([impressionId])
  @@map("ad_clicks")
}

model PageViewDailyStat {
  id        Int      @id @default(autoincrement())
  pageUrl   String   @map("page_url") @db.VarChar(255)
  viewDate  DateTime @map("view_date") @db.Date
  viewCount Int      @default(0) @map("view_count")

  @@unique([pageUrl, viewDate])
  @@index([viewDate])
  @@map("page_view_daily_stats")
}

model SearchLog {
  id           BigInt   @id @default(autoincrement())
  userId       Int?     @map("user_id")
  user         User?    @relation(fields: [userId], references: [id])
  searchQuery  String?  @map("search_query") @db.VarChar(255)
  resultsCount Int?     @map("results_count")
  pageUrl      String?  @map("page_url") @db.VarChar(255)
  deviceType   String?  @map("device_type") @db.VarChar(20)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  createdAt    DateTime @default(now()) @map("created_at")
  sessionId    String?  @map("session_id") @db.VarChar(100)
  userAgent    String?  @map("user_agent") @db.VarChar(255)

  @@index([createdAt])
  @@index([userId])
  @@map("search_logs")
}

