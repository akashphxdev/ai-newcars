// ============================================================
// TimesAuto — Prisma Schema (PostgreSQL)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// LOCATION
// ============================================================

model Country {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  code           String   @db.VarChar(5)
  currency       String?  @db.VarChar(50)
  currencySymbol String?  @map("currency_symbol") @db.VarChar(10)
  currencyCode   String?  @map("currency_code") @db.VarChar(10)
  exchangeRate   Decimal? @map("exchange_rate") @db.Decimal(12, 6)
  distanceUnit   String?  @default("KM") @map("distance_unit") @db.VarChar(10)
  fuelUnit       String?  @default("Liter") @map("fuel_unit") @db.VarChar(10)
  isActive       Boolean  @default(true) @map("is_active")

  states State[]
  brands Brand[]

  @@map("countries")
}

model State {
  id             Int             @id @default(autoincrement())
  countryId      Int             @map("country_id")
  name           String          @db.VarChar(100)
  code           String?         @db.VarChar(10)
  country        Country         @relation(fields: [countryId], references: [id])
  cities         City[]
  insuranceLeads InsuranceLead[]

  @@index([countryId])
  @@map("states")
}

model City {
  id               Int     @id @default(autoincrement())
  stateId          Int     @map("state_id")
  name             String  @db.VarChar(100)
  slug             String  @unique @db.VarChar(100)
  isMetro          Boolean @default(false) @map("is_metro")
  isTopCity        Boolean @default(false) @map("is_top_city")
  isSellCarEnabled Boolean @default(false) @map("is_sell_car_enabled")
  logoUrl          String? @map("logo_url") @db.VarChar(255)
  state            State   @relation(fields: [stateId], references: [id])

  users           User[]
  usedCarListings UsedCarListing[]
  newCarOffers    NewCarOffer[]
  sellCarLeads    SellCarLead[]
  buyNewCarLeads  BuyNewCarLead[]
  insuranceLeads  InsuranceLead[]
  userAddresses   UserAddress[]

  @@index([stateId])
  @@map("cities")
}

// ============================================================
// SHARED LOOKUPS (used by new-car specs)
// ============================================================

model BodyType {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50)
  slug        String   @unique @db.VarChar(50)
  iconUrl     String?  @map("icon_url") @db.VarChar(255)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  carModels CarModel[]

  @@map("body_types")
}

// Shared lookup table for small, fixed-choice vehicle attributes that are
// reused across multiple specs (transmission, drivetrain, and future ones
// like fuel-type) — one table instead of a separate one per attribute.
// `category` scopes each row (e.g. "transmission", "drivetrain"); the
// (category, slug) pair is what's actually unique, not slug alone, so two
// different categories are free to both have e.g. slug "standard" later.
model AttributeOption {
  id       Int    @id @default(autoincrement())
  category String @db.VarChar(30)
  name     String @db.VarChar(50)
  slug     String @db.VarChar(50)

  variantTransmissions CarVariant[]            @relation("VariantTransmission")
  iceDrivetrains       CarPowertrainIce[]      @relation("IceDrivetrain")
  electricDrivetrains  CarPowertrainElectric[] @relation("ElectricDrivetrain")

  @@unique([category, slug])
  @@map("attribute_options")
}

// ============================================================
// ADMIN
// ============================================================

model Role {
  id            Int      @id @default(autoincrement())
  roleName      String   @map("role_name") @db.VarChar(50)
  parentRoleId  Int?     @map("parent_role_id")
  parentRole    Role?    @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles    Role[]   @relation("RoleHierarchy")
  permissionIds Json?    @map("permission_ids")
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  adminUsers AdminUser[]

  @@map("roles")
}

model Permission {
  id            Int    @id @default(autoincrement())
  module        String @db.VarChar(50)
  action        String @db.VarChar(20)
  permissionKey String @unique @map("permission_key") @db.VarChar(100)

  @@map("permissions")
}

model AdminUser {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(100)
  email               String    @unique @db.VarChar(150)
  mobile              String    @unique @db.VarChar(15)
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  roleId              Int       @map("role_id")
  role                Role      @relation(fields: [roleId], references: [id])
  status              String    @default("active") @db.VarChar(20)
  accessStartDate     DateTime? @map("access_start_date") @db.Date
  accessEndDate       DateTime? @map("access_end_date") @db.Date
  lastLoginAt         DateTime? @map("last_login_at")
  lastLoginIp         String?   @map("last_login_ip") @db.VarChar(45)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  isLocked            Boolean   @default(false) @map("is_locked")
  lockType            String?   @map("lock_type") @db.VarChar(20)
  lockedBy            Int?      @map("locked_by")
  lockedAt            DateTime? @map("locked_at")
  lockedReason        String?   @map("locked_reason") @db.VarChar(255)
  unlockedBy          Int?      @map("unlocked_by")
  unlockedAt          DateTime? @map("unlocked_at")
  createdBy           Int?      @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")

  lockedByAdmin   AdminUser? @relation("LockedByAdmin", fields: [lockedBy], references: [id])
  unlockedByAdmin AdminUser? @relation("UnlockedByAdmin", fields: [unlockedBy], references: [id])
  createdByAdmin  AdminUser? @relation("CreatedByAdmin", fields: [createdBy], references: [id])

  lockedAccounts   AdminUser[] @relation("LockedByAdmin")
  unlockedAccounts AdminUser[] @relation("UnlockedByAdmin")
  createdAccounts  AdminUser[] @relation("CreatedByAdmin")

  adminLogs             AdminLog[]
  adminOtpVerifications AdminOtpVerification[]
  deletedIcePowertrains CarPowertrainIce[]
  deletedEvPowertrains  CarPowertrainElectric[]
  leadActivities        LeadActivity[]
  seoMetaCreated        SeoMeta[]               @relation("SeoMetaCreatedBy")
  seoMetaUpdated        SeoMeta[]               @relation("SeoMetaUpdatedBy")
  seoRedirectsCreated   SeoRedirect[]           @relation("SeoRedirectCreatedBy")
  seoRedirectsUpdated   SeoRedirect[]           @relation("SeoRedirectUpdatedBy")

  articlesAuthored         Article[]         @relation("ArticleAuthor")
  articlesCreated          Article[]         @relation("ArticleCreatedBy")
  articlesUpdated          Article[]         @relation("ArticleUpdatedBy")
  articleCategoriesCreated ArticleCategory[] @relation("ArticleCategoryCreatedBy")
  articleCategoriesUpdated ArticleCategory[] @relation("ArticleCategoryUpdatedBy")

  adPlacementsCreated AdPlacement[] @relation("AdPlacementCreatedBy")
  adPlacementsUpdated AdPlacement[] @relation("AdPlacementUpdatedBy")
  advertisersCreated  Advertiser[]  @relation("AdvertiserCreatedBy")
  advertisersUpdated  Advertiser[]  @relation("AdvertiserUpdatedBy")
  lendersCreated      Lender[]      @relation("LenderCreatedBy")
  lendersUpdated      Lender[]      @relation("LenderUpdatedBy")

  adCampaignsCreated AdCampaign[] @relation("AdCampaignCreatedBy")
  adCampaignsUpdated AdCampaign[] @relation("AdCampaignUpdatedBy")

  storyGroupsCreated StoryGroup[] @relation("StoryGroupCreatedBy")
  storyGroupsUpdated StoryGroup[] @relation("StoryGroupUpdatedBy")
  storyItemsCreated  StoryItem[]  @relation("StoryItemCreatedBy")
  storyItemsUpdated  StoryItem[]  @relation("StoryItemUpdatedBy")

  siteSettingsCreated SiteSetting[] @relation("SiteSettingCreatedBy")
  siteSettingsUpdated SiteSetting[] @relation("SiteSettingUpdatedBy")

  bannersCreated Banner[] @relation("BannerCreatedBy")
  bannersUpdated Banner[] @relation("BannerUpdatedBy")

  testimonialsCreated  Testimonial[] @relation("TestimonialCreatedBy")
  testimonialsReviewed Testimonial[] @relation("TestimonialReviewedBy")
  reviewRepliesPosted  ReviewReply[]

  @@index([roleId])
  @@map("admin_users")
}

model AdminLog {
  id          BigInt    @id @default(autoincrement())
  adminId     Int       @map("admin_id")
  admin       AdminUser @relation(fields: [adminId], references: [id])
  description String?   @db.VarChar(255)
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@map("admin_logs")
}

model AdminOtpVerification {
  id         Int       @id @default(autoincrement())
  adminId    Int       @map("admin_id")
  admin      AdminUser @relation(fields: [adminId], references: [id])
  mobile     String    @db.VarChar(15)
  otpCode    String    @map("otp_code") @db.VarChar(6)
  purpose    String    @db.VarChar(20)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([mobile, purpose])
  @@map("admin_otp_verifications")
}

// ============================================================
// PUBLIC USERS
// ============================================================

model User {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(100)
  email               String?   @unique @db.VarChar(150)
  mobile              String    @unique @db.VarChar(15)
  passwordHash        String?   @map("password_hash") @db.VarChar(255)
  cityId              Int?      @map("city_id")
  city                City?     @relation(fields: [cityId], references: [id])
  isVerified          Boolean   @default(true) @map("is_verified")
  status              String    @default("active") @db.VarChar(20)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  isLocked            Boolean   @default(false) @map("is_locked")
  lockedAt            DateTime? @map("locked_at")
  lockedReason        String?   @map("locked_reason") @db.VarChar(255)
  lastLoginAt         DateTime? @map("last_login_at")
  lastLoginIp         String?   @map("last_login_ip") @db.VarChar(45)
  createdAt           DateTime  @default(now()) @map("created_at")

  usedCarListings     UsedCarListing[]
  sellCarLeads        SellCarLead[]
  buyNewCarLeads      BuyNewCarLead[]
  buyUsedCarLeads     BuyUsedCarLead[]
  insuranceLeads      InsuranceLead[]
  loanLeads           LoanLead[]
  softLeads           SoftLead[]
  priceDropAlertLeads PriceDropAlertLead[]
  wishlists           Wishlist[]
  launchNotifyLeads   LaunchNotifyLead[]
  reviews             Review[]
  reviewReplies       ReviewReply[]
  reviewHelpfulVotes  ReviewHelpfulVote[]
  adImpressions       AdImpression[]
  adClicks            AdClick[]
  searchLogs          SearchLog[]
  userAddresses       UserAddress[]
  testimonials        Testimonial[]

  @@map("users")
}

model UserOtpVerification {
  id         Int       @id @default(autoincrement())
  mobile     String    @db.VarChar(15)
  email      String?   @db.VarChar(150)
  otpCode    String    @map("otp_code") @db.VarChar(6)
  purpose    String    @db.VarChar(20)
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([mobile, purpose])
  @@map("user_otp_verifications")
}

// ============================================================
// CARS — COMMON
// ============================================================

model Brand {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(100)
  slug            String   @unique @db.VarChar(100)
  logoUrl         String?  @map("logo_url") @db.VarChar(255)
  countryOriginId Int?     @map("country_origin_id")
  countryOrigin   Country? @relation(fields: [countryOriginId], references: [id])
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  carModels           CarModel[]
  sellCarLeads        SellCarLead[]
  buyNewCarLeads      BuyNewCarLead[]
  buyUsedCarLeads     BuyUsedCarLead[]
  insuranceLeads      InsuranceLead[]
  loanLeads           LoanLead[]
  softLeads           SoftLead[]
  priceDropAlertLeads PriceDropAlertLead[]
  launchNotifyLeads   LaunchNotifyLead[]
  articleBrands       ArticleBrand[]

  @@map("brands")
}

model CarModel {
  id                 Int       @id @default(autoincrement())
  brandId            Int       @map("brand_id")
  brand              Brand     @relation(fields: [brandId], references: [id])
  name               String    @db.VarChar(100)
  slug               String    @unique @db.VarChar(100)
  bodyTypeId         Int?      @map("body_type_id")
  bodyType           BodyType? @relation(fields: [bodyTypeId], references: [id])
  launchStatus       String    @default("available") @map("launch_status") @db.VarChar(20)
  expectedLaunchDate DateTime? @map("expected_launch_date") @db.Date
  priceMin           Decimal?  @map("price_min") @db.Decimal(12, 2)
  priceMax           Decimal?  @map("price_max") @db.Decimal(12, 2)
  ratingAvg          Decimal?  @map("rating_avg") @db.Decimal(3, 2)
  coverImageUrl      String?   @map("cover_image_url") @db.VarChar(255)
  createdAt          DateTime  @default(now()) @map("created_at")

  variants            CarVariant[]
  images              CarImage[]
  faqs                CarFaq[]
  colors              CarColor[]
  newCarOffers        NewCarOffer[]
  usedCarListings     UsedCarListing[]
  sellCarLeads        SellCarLead[]
  buyNewCarLeads      BuyNewCarLead[]
  buyUsedCarLeads     BuyUsedCarLead[]
  insuranceLeads      InsuranceLead[]
  loanLeads           LoanLead[]
  softLeads           SoftLead[]
  priceDropAlertLeads PriceDropAlertLead[]
  wishlists           Wishlist[]
  launchNotifyLeads   LaunchNotifyLead[]
  reviews             Review[]
  articleCarModels    ArticleCarModel[]

  @@index([brandId])
  @@index([bodyTypeId])
  @@index([launchStatus])
  @@index([priceMin])
  @@map("car_models")
}

model CarVariant {
  id              Int             @id @default(autoincrement())
  modelId         Int             @map("model_id")
  model           CarModel        @relation(fields: [modelId], references: [id])
  variantName     String          @map("variant_name") @db.VarChar(100)
  price           Decimal         @db.Decimal(12, 2)
  seatingCapacity Int             @map("seating_capacity")
  transmissionId  Int             @map("transmission_id")
  transmission    AttributeOption @relation("VariantTransmission", fields: [transmissionId], references: [id], onDelete: Restrict)
  isTopSeller     Boolean         @default(false) @map("is_top_seller")
  createdAt       DateTime        @default(now()) @map("created_at")
  length          Int?            @map("length_mm")
  width           Int?            @map("width_mm")
  height          Int?            @map("height_mm")
  wheelBase       Int?            @map("wheel_base_mm")
  groundClearance Int?            @map("ground_clearance_mm")
  bootSpace       Int?            @map("boot_space_litres")
  frontSuspension String?         @map("front_suspension") @db.VarChar(100)
  rearSuspension  String?         @map("rear_suspension") @db.VarChar(100)
  steeringType    String?         @map("steering_type") @db.VarChar(50)
  frontBrakeType  String?         @map("front_brake_type") @db.VarChar(50)
  rearBrakeType   String?         @map("rear_brake_type") @db.VarChar(50)

  icePowertrains      CarPowertrainIce[]
  electricPowertrains CarPowertrainElectric[]
  features            VariantFeature[]
  newCarOffers        NewCarOffer[]
  usedCarListings     UsedCarListing[]
  reviews             Review[]
  buyNewCarLeads      BuyNewCarLead[]
  insuranceLeads      InsuranceLead[]
  loanLeads           LoanLead[]

  @@unique([modelId, variantName])
  @@index([modelId])
  @@map("car_variants")
}

model CarPowertrainIce {
  id                     Int              @id @default(autoincrement())
  variantId              Int              @map("variant_id")
  variant                CarVariant       @relation(fields: [variantId], references: [id])
  fuelType               Int              @map("fuel_type")
  fuelTypeSubCategory    String?          @map("fuel_type_sub_category") @db.VarChar(30)
  fuelTankCapacity       Decimal?         @map("fuel_tank_capacity") @db.Decimal(5, 2)
  cngTankCapacity        Decimal?         @map("cng_tank_capacity") @db.Decimal(5, 2)
  kerbWeight             Int?             @map("kerb_weight")
  engineDisplacement     Decimal?         @map("engine_displacement") @db.Decimal(5, 2)
  cubicCapacity          Int?             @map("cubic_capacity")
  cylinders              Int?
  numGears               Int?             @map("num_gears")
  isFourByFour           Boolean          @default(false) @map("is_four_by_four")
  drivetrainId           Int?             @map("drivetrain_id")
  drivetrain             AttributeOption? @relation("IceDrivetrain", fields: [drivetrainId], references: [id])
  powerPs                Int?             @map("power_ps")
  powerMinRpm            Int?             @map("power_min_rpm")
  powerMaxRpm            Int?             @map("power_max_rpm")
  torqueNm               Int?             @map("torque_nm")
  torqueMinRpm           Int?             @map("torque_min_rpm")
  torqueMaxRpm           Int?             @map("torque_max_rpm")
  claimedFe              Decimal?         @map("claimed_fe") @db.Decimal(5, 2)
  realWorldMileage       Decimal?         @map("real_world_mileage") @db.Decimal(5, 2)
  topSpeedKmph           Int?             @map("top_speed_kmph")
  topSpeedTimeSec        Decimal?         @map("top_speed_time_sec") @db.Decimal(5, 2)
  isDefault              Boolean          @default(false) @map("is_default")
  isDeleted              Boolean          @default(false) @map("is_deleted")
  deletedBy              Int?             @map("deleted_by")
  deletedByAdmin         AdminUser?       @relation(fields: [deletedBy], references: [id])
  deletedAt              DateTime?        @map("deleted_at")
  expiresAt              DateTime?        @map("expires_at")
  createdAt              DateTime         @default(now()) @map("created_at")
  emissionNormCompliance String?          @map("emission_norm_compliance") @db.VarChar(30)
  turboCharger           Boolean          @default(false) @map("turbo_charger")

  @@index([variantId, isDeleted])
  @@map("car_powertrains_ice")
}

model CarPowertrainElectric {
  id                        Int              @id @default(autoincrement())
  variantId                 Int              @map("variant_id")
  variant                   CarVariant       @relation(fields: [variantId], references: [id])
  numMotors                 Int?             @map("num_motors")
  motorType                 String?          @map("motor_type") @db.VarChar(50)
  batteryCapacity           Decimal?         @map("battery_capacity") @db.Decimal(6, 2)
  batteryChemistry          String?          @map("battery_chemistry") @db.VarChar(30)
  thermalManagementSystem   String?          @map("thermal_management_system") @db.VarChar(50)
  drivetrainId              Int?             @map("drivetrain_id")
  drivetrain                AttributeOption? @relation("ElectricDrivetrain", fields: [drivetrainId], references: [id])
  powerPs                   Int?             @map("power_ps")
  torqueNm                  Int?             @map("torque_nm")
  claimedRange              Int?             @map("claimed_range")
  realWorldRange            Int?             @map("real_world_range")
  topSpeedKmph              Int?             @map("top_speed_kmph")
  topSpeedTimeSec           Decimal?         @map("top_speed_time_sec") @db.Decimal(5, 2)
  acChargingOutput          Decimal?         @map("ac_charging_output") @db.Decimal(5, 2)
  acChargingTime            Decimal?         @map("ac_charging_time") @db.Decimal(5, 2)
  dcChargingOutput          Decimal?         @map("dc_charging_output") @db.Decimal(5, 2)
  dcFastChargingTime        String?          @map("dc_fast_charging_time") @db.VarChar(50)
  batteryWarrantyKm         Int?             @map("battery_warranty_km")
  batteryWarrantyYears      Int?             @map("battery_warranty_years")
  motorWarrantyKm           Int?             @map("motor_warranty_km")
  motorWarrantyYears        Int?             @map("motor_warranty_years")
  standardWarrantyKm        String?          @map("standard_warranty_km") @db.VarChar(20)
  standardWarrantyYears     Int?             @map("standard_warranty_years")
  isDefault                 Boolean          @default(false) @map("is_default")
  isDeleted                 Boolean          @default(false) @map("is_deleted")
  deletedBy                 Int?             @map("deleted_by")
  deletedByAdmin            AdminUser?       @relation(fields: [deletedBy], references: [id])
  deletedAt                 DateTime?        @map("deleted_at")
  expiresAt                 DateTime?        @map("expires_at")
  createdAt                 DateTime         @default(now()) @map("created_at")
  emissionNormCompliance    String?          @map("emission_norm_compliance") @db.VarChar(30)
  motorPowerKw              Decimal?         @map("motor_power_kw") @db.Decimal(6, 2)
  chargingPort              String?          @map("charging_port") @db.VarChar(30)
  chargingOptionsRaw        String?          @map("charging_options_raw") @db.VarChar(255)
  regenerativeBraking       Boolean          @default(false) @map("regenerative_braking")
  regenerativeBrakingLevels Int?             @map("regenerative_braking_levels")

  @@index([variantId, isDeleted])
  @@map("car_powertrains_electric")
}

model CarImage {
  id        Int       @id @default(autoincrement())
  modelId   Int       @map("model_id")
  model     CarModel  @relation(fields: [modelId], references: [id])
  colorId   Int?      @map("color_id")
  color     CarColor? @relation(fields: [colorId], references: [id])
  imageUrl  String    @map("image_url") @db.VarChar(255)
  isPrimary Boolean   @default(false) @map("is_primary")
  angle     String?   @db.VarChar(30)

  @@index([modelId])
  @@map("car_images")
}

model FeatureCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  features Feature[]

  @@map("feature_categories")
}

model Feature {
  id         Int              @id @default(autoincrement())
  name       String           @unique @db.VarChar(150)
  categoryId Int?             @map("category_id")
  category   FeatureCategory? @relation(fields: [categoryId], references: [id])
  createdAt  DateTime         @default(now()) @map("created_at")

  variantFeatures VariantFeature[]

  @@index([categoryId])
  @@map("features")
}

model VariantFeature {
  id        Int        @id @default(autoincrement())
  variantId Int        @map("variant_id")
  variant   CarVariant @relation(fields: [variantId], references: [id])
  featureId Int        @map("feature_id")
  feature   Feature    @relation(fields: [featureId], references: [id])
  value     String?    @db.VarChar(100)
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([variantId, featureId])
  @@index([featureId])
  @@map("variant_features")
}

model CarFaq {
  id           Int      @id @default(autoincrement())
  modelId      Int      @map("model_id")
  model        CarModel @relation(fields: [modelId], references: [id])
  question     String   @db.VarChar(255)
  answer       String
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  viewCount    Int      @default(0) @map("view_count")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([modelId, displayOrder], name: "car_faqs_model_display_order_unique")
  @@map("car_faqs")
}

model CarColor {
  id             Int      @id @default(autoincrement())
  modelId        Int      @map("model_id")
  model          CarModel @relation(fields: [modelId], references: [id])
  colorName      String   @map("color_name") @db.VarChar(50)
  imageUrl       String?  @map("image_url") @db.VarChar(255)
  additionalCost Decimal? @map("additional_cost") @db.Decimal(8, 2)

  shades CarColorShade[]
  images CarImage[]

  @@index([modelId])
  @@map("car_colors")
}

model CarColorShade {
  id        Int      @id @default(autoincrement())
  colorId   Int      @map("color_id")
  color     CarColor @relation(fields: [colorId], references: [id], onDelete: Cascade)
  colorHex  String   @map("color_hex") @db.VarChar(7)
  // Display order within the parent color (0, 1, 2...) — keeps a
  // multi-shade swatch rendering in the order the admin set it.
  sortOrder Int      @default(0) @map("sort_order")

  @@map("car_color_shades")
}

// ============================================================
// CARS — NEW
// ============================================================

// ============================================================
// CODEX STAGING
// ============================================================

// Codex-generated rows stay here until an admin approves or rejects them.
model CodexRun {
  id           BigInt    @id @default(autoincrement())
  taskType     String    @map("task_type") @db.VarChar(50)
  status       String    @default("running") @db.VarChar(20)
  prompt       String?   @db.Text
  sourceUrl    String?   @map("source_url") @db.VarChar(500)
  errorMessage String?   @map("error_message") @db.Text
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  events              CodexProposalEvent[]
  brands              CodexBrand[]
  carModels           CodexCarModel[]
  carVariants         CodexCarVariant[]
  powertrainsIce      CodexPowertrainIce[]
  powertrainsElectric CodexPowertrainElectric[]
  featureCategories   CodexFeatureCategory[]
  features            CodexFeature[]
  variantFeatures     CodexVariantFeature[]
  carColors           CodexCarColor[]
  carColorShades      CodexCarColorShade[]
  carImages           CodexCarImage[]
  articles            CodexArticle[]
  articleBrands       CodexArticleBrand[]
  articleCarModels    CodexArticleCarModel[]
  carFaqs             CodexCarFaq[]
  variantPriceChanges CodexVariantPriceChange[]

  @@index([status, startedAt])
  @@map("codex_runs")
}

model CodexProposalEvent {
  id         BigInt    @id @default(autoincrement())
  runId      BigInt?   @map("run_id")
  run        CodexRun? @relation(fields: [runId], references: [id])
  entityType String    @map("entity_type") @db.VarChar(50)
  entityId   Int?      @map("entity_id")
  action     String    @db.VarChar(30)
  message    String?   @db.VarChar(255)
  payload    Json?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([runId, createdAt])
  @@index([entityType, entityId])
  @@map("codex_proposal_events")
}

model CodexBrand {
  id              Int       @id @default(autoincrement())
  runId           BigInt?   @map("run_id")
  run             CodexRun? @relation(fields: [runId], references: [id])
  name            String    @db.VarChar(100)
  slug            String    @db.VarChar(100)
  logoUrl         String?   @map("logo_url") @db.VarChar(255)
  countryOriginId Int?      @map("country_origin_id")
  isActive        Boolean   @default(true) @map("is_active")
  proposalStatus  String    @default("pending") @map("proposal_status") @db.VarChar(20)
  reviewedBy      Int?      @map("reviewed_by")
  reviewedAt      DateTime? @map("reviewed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  carModels     CodexCarModel[]
  articleBrands CodexArticleBrand[]

  @@index([proposalStatus, createdAt])
  @@index([slug])
  @@map("codex_brands")
}

model CodexCarModel {
  id                 Int         @id @default(autoincrement())
  runId              BigInt?     @map("run_id")
  run                CodexRun?   @relation(fields: [runId], references: [id])
  brandId            Int?        @map("brand_id")
  codexBrandId       Int?        @map("codex_brand_id")
  codexBrand         CodexBrand? @relation(fields: [codexBrandId], references: [id])
  name               String      @db.VarChar(100)
  slug               String      @db.VarChar(100)
  bodyTypeId         Int?        @map("body_type_id")
  launchStatus       String      @default("available") @map("launch_status") @db.VarChar(20)
  expectedLaunchDate DateTime?   @map("expected_launch_date") @db.Date
  priceMin           Decimal?    @map("price_min") @db.Decimal(12, 2)
  priceMax           Decimal?    @map("price_max") @db.Decimal(12, 2)
  ratingAvg          Decimal?    @map("rating_avg") @db.Decimal(3, 2)
  coverImageUrl      String?     @map("cover_image_url") @db.VarChar(255)
  proposalStatus     String      @default("pending") @map("proposal_status") @db.VarChar(20)
  reviewedBy         Int?        @map("reviewed_by")
  reviewedAt         DateTime?   @map("reviewed_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  variants         CodexCarVariant[]
  images           CodexCarImage[]
  faqs             CodexCarFaq[]
  colors           CodexCarColor[]
  articleCarModels CodexArticleCarModel[]

  @@index([brandId])
  @@index([codexBrandId])
  @@index([bodyTypeId])
  @@index([proposalStatus, createdAt])
  @@index([slug])
  @@map("codex_car_models")
}

model CodexCarVariant {
  id              Int            @id @default(autoincrement())
  runId           BigInt?        @map("run_id")
  run             CodexRun?      @relation(fields: [runId], references: [id])
  modelId         Int?           @map("model_id")
  codexModelId    Int?           @map("codex_model_id")
  codexModel      CodexCarModel? @relation(fields: [codexModelId], references: [id])
  variantName     String         @map("variant_name") @db.VarChar(100)
  price           Decimal        @db.Decimal(12, 2)
  seatingCapacity Int            @map("seating_capacity")
  transmissionId  Int            @map("transmission_id")
  isTopSeller     Boolean        @default(false) @map("is_top_seller")
  length          Int?           @map("length_mm")
  width           Int?           @map("width_mm")
  height          Int?           @map("height_mm")
  wheelBase       Int?           @map("wheel_base_mm")
  groundClearance Int?           @map("ground_clearance_mm")
  bootSpace       Int?           @map("boot_space_litres")
  frontSuspension String?        @map("front_suspension") @db.VarChar(100)
  rearSuspension  String?        @map("rear_suspension") @db.VarChar(100)
  steeringType    String?        @map("steering_type") @db.VarChar(50)
  frontBrakeType  String?        @map("front_brake_type") @db.VarChar(50)
  rearBrakeType   String?        @map("rear_brake_type") @db.VarChar(50)
  proposalStatus  String         @default("pending") @map("proposal_status") @db.VarChar(20)
  reviewedBy      Int?           @map("reviewed_by")
  reviewedAt      DateTime?      @map("reviewed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  icePowertrains      CodexPowertrainIce[]
  electricPowertrains CodexPowertrainElectric[]
  features            CodexVariantFeature[]

  @@index([modelId])
  @@index([codexModelId])
  @@index([proposalStatus, createdAt])
  @@map("codex_car_variants")
}

