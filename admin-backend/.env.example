NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://postgres:admin123@localhost:5432/timesauto?schema=public"

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# 64-char hex string (32 bytes) — generate with: openssl rand -hex 32
AI_SETTINGS_ENCRYPTION_KEY=change_this_to_a_64_char_hex_string

CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Public API response cache — optional, defaults to localhost if unset
REDIS_URL=redis://localhost:6379

#Email Otp Auth
GMAIL_USER=example8@gmail.com
GMAIL_APP_PASSWORD=

# Asset storage
# Where uploaded files are physically written. In production this is the
# volume nginx publishes as static.timesauto.net. Unset = ./uploads.
ASSET_STORAGE_ROOT=/var/www/static.timesauto.net

# Origin serving the files above. Only used to build the convenience
# `url` field on upload responses — what gets stored in the database is
# always the host-relative path, so this hostname never enters the data.
ASSET_PUBLIC_BASE_URL=https://static.timesauto.net
