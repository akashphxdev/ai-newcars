# Admin API — same host as the public API, separated by path.
VITE_API_BASE_URL=https://api.timesauto.net/api/v1

# CDN origin serving uploaded assets. Unset, asset paths resolve against the
# API origin, which is what makes local development work without a CDN.
VITE_ASSET_BASE_URL=https://static.timesauto.net
